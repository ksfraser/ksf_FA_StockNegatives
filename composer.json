{
    "name": "ksfraser/ksf-fa-stock-negatives",
    "description": "FrontAccounting Stock Negatives Report - identifies inventory items with negative quantities",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-common-db": "^1.0",
        "ksfraser/exceptions": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "ksfraser/famock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\FrontAccounting\\StockNegatives\\": "src/Ksfraser/FrontAccounting/StockNegatives/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\FrontAccounting\\StockNegatives\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ksf_common_db",
            "canonical": false
        }
    ]
}